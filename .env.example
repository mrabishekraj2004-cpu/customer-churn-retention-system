# ============================================================
# Customer Churn Prediction + Retention Action System
# Environment Configuration
# ============================================================

# Application
APP_NAME="Customer Churn Prediction API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# Logging
LOG_LEVEL="INFO"

# Authentication
#
# Generate a unique, cryptographically secure secret for each deployment.
# Never commit the real JWT secret to Git.
JWT_SECRET_KEY="replace-with-a-strong-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Machine Learning Model
MODEL_PATH="models/churn_pipeline.joblib"
MODEL_METADATA_PATH="models/churn_pipeline_metadata.json"

# CORS
#
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Database
#
# Default local development database:
DATABASE_URL="sqlite:///./customer_churn.db"

# Example PostgreSQL configuration for a future deployment:
# DATABASE_URL="postgresql+psycopg://username:password@localhost:5432/customer_churn"

# Docker deployment database example:
# DATABASE_URL="sqlite:////app/data/customer_churn.db"
